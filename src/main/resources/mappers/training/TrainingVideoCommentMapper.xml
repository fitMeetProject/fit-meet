<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ssafy.fitmeet.domain.training.dao.TrainingVideoCommentDao">

    <resultMap id="TrainingVideoCommentMap" type="com.ssafy.fitmeet.domain.training.entity.TrainingVideoComment">
        <id property="id" column="id"/>
        <result property="videoId" column="video_id"/>
        <result property="userId" column="user_id"/>
        <result property="content" column="content"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="deletedAt" column="deleted_at"/>
    </resultMap>

    <select id="findByVideoId" resultMap="TrainingVideoCommentMap">
        SELECT *
        FROM training_video_comment
        WHERE video_id = #{videoId}
        AND deleted_at IS NULL
        ORDER BY created_at ASC
    </select>

    <select id="findById" resultMap="TrainingVideoCommentMap">
        SELECT *
        FROM training_video_comment
        WHERE id = #{id}
    </select>

    <insert id="insertComment" parameterType="com.ssafy.fitmeet.domain.training.entity.TrainingVideoComment" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO training_video_comment (
        video_id, user_id, content, created_at, updated_at
        ) VALUES (
        #{videoId}, #{userId}, #{content}, NOW(), NOW()
        )
    </insert>

    <update id="softDelete">
        UPDATE training_video_comment
        SET deleted_at = NOW()
        WHERE id = #{id}
    </update>

</mapper>
