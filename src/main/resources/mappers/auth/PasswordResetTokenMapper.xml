<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ssafy.fitmeet.domain.auth.dao.PasswordResetTokenDao">

    <resultMap id="PasswordResetTokenMap" type="com.ssafy.fitmeet.domain.auth.entity.PasswordResetToken">
        <id     property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="token" column="token"/>
        <result property="expiresAt" column="expires_at"/>
        <result property="used" column="used"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <!-- 토큰으로 조회 -->
    <select id="findByToken" resultMap="PasswordResetTokenMap">
        SELECT
        id,
        user_id,
        token,
        expires_at,
        used,
        created_at
        FROM password_reset_token
        WHERE token = #{token}
    </select>

    <!-- 새 토큰 삽입 -->
    <insert id="insert" parameterType="com.ssafy.fitmeet.domain.auth.entity.PasswordResetToken" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO password_reset_token (
        user_id,
        token,
        expires_at,
        used,
        created_at
        ) VALUES (
        #{userId},
        #{token},
        #{expiresAt},
        #{used},
        #{createdAt}
        )
    </insert>

    <!-- 특정 토큰 사용 처리 -->
    <update id="markAsUsed">
        UPDATE password_reset_token
        SET used = 1
        WHERE id = #{id}
    </update>

    <!-- 특정 유저의 모든 미사용 토큰 사용 처리 -->
    <update id="markAllAsUsedByUserId">
        UPDATE password_reset_token
        SET used = 1
        WHERE user_id = #{userId}
        AND used = 0
    </update>

    <!-- 만료된 토큰 삭제 -->
    <delete id="deleteExpiredTokens">
        DELETE FROM password_reset_token
        WHERE expires_at &lt; #{now}
    </delete>

    <!-- 특정 유저의 모든 토큰 삭제 (선택) -->
    <delete id="deleteByUserId">
        DELETE FROM password_reset_token
        WHERE user_id = #{userId}
    </delete>

</mapper>
