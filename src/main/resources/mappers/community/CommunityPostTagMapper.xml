<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ssafy.fitmeet.domain.community.dao.CommunityPostTagDao">

    <!-- 매핑 추가 -->
    <insert id="insert">
        INSERT IGNORE INTO `community_post_tag` (`post_id`, `tag_id`)
        VALUES (#{postId}, #{tagId})
    </insert>

    <!-- 특정 게시글의 태그 전체 삭제 (수정 시 필요) -->
    <delete id="deleteByPostId">
        DELETE FROM `community_post_tag`
        WHERE `post_id` = #{postId}
    </delete>

    <!-- 게시글 태그 목록 조회 -->
    <select id="findTagsByPostId" resultType="string">
        SELECT t.name
        FROM `community_post_tag` pt
        JOIN `community_tag` t ON pt.tag_id = t.id
        WHERE pt.post_id = #{postId}
        ORDER BY t.name ASC
    </select>

</mapper>
