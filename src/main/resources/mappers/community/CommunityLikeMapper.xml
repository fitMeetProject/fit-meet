<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ssafy.fitmeet.domain.community.dao.CommunityLikeDao">

    <!-- 좋아요 추가 -->
    <insert id="insert">
        INSERT INTO `community_post_like` (`post_id`, `user_id`, `created_at`)
        VALUES (
        #{postId}, #{userId},
        <choose>
            <when test="createdAt != null">#{createdAt}</when>
            <otherwise>NOW()</otherwise>
        </choose>
        )
    </insert>

    <!-- 좋아요 취소 -->
    <delete id="delete">
        DELETE FROM `community_post_like`
        WHERE `post_id` = #{postId}
        AND `user_id` = #{userId}
    </delete>

    <!-- 좋아요 여부 확인 -->
    <select id="exists" resultType="int">
        SELECT COUNT(*)
        FROM `community_post_like`
        WHERE `post_id` = #{postId}
        AND `user_id` = #{userId}
    </select>

</mapper>
